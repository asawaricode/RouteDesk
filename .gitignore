# ─── Secrets / Environment ───────────────────────────────────────────────────
**/.env
.env
.env.*
!**/.env.example

# ─── Node / JavaScript ───────────────────────────────────────────────────────
**/node_modules/
**/dist/
**/build/
**/.next/
**/.nuxt/
**/out/

# ─── Python ──────────────────────────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/.venv/
**/venv/
**/env/
**/*.egg-info/
**/dist-info/
**/.pytest_cache/
**/*.pyc

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/

# ─── ML artifacts (large model binaries) ──────────────────────────────────
**/artifacts/*.joblib
**/artifacts/*.pkl
**/artifacts/*.pt
**/artifacts/*.bin
**/artifacts/*.onnx
# Keep small metrics, classes, and confusion matrix CSV eligible for git

# ─── Package manager lock files (keep package-lock.json / requirements.txt) ─
# Intentionally NOT ignoring lock files

