# Backend Environment Variables
# Copy this file to .env and fill in real values — never commit .env

PORT=4000

# URL of the ML service (used for internal calls)
ML_SERVICE_URL=http://localhost:8000

# Node environment: development | production
NODE_ENV=development

# Supabase configuration
# SUPABASE_URL: Project base URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY: Backend secret / service role key (bypasses RLS - keep secure and backend only)
SUPABASE_SECRET_KEY=your_supabase_secret_key
