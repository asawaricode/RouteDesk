# ML Service .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Environment
.env
.venv/
venv/
env/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Large model artifacts (do NOT commit large binaries)
artifacts/*.joblib
artifacts/*.pkl
artifacts/*.pt
artifacts/*.bin
artifacts/*.onnx
# ^ keep small results eligible for Git:
# artifacts/metrics.json, artifacts/classes.json, artifacts/confusion_matrix.csv

# Legacy / old model dirs
models/

# Hugging Face dataset cache
.cache/
~/.cache/huggingface/
